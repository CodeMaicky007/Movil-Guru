# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site (usado para construir URLs de tracking en emails)
NEXT_PUBLIC_SITE_URL=https://movilguru.com

# Groq AI — varias keys separadas por coma para rotación automática.
# Cuando una se queda sin tokens, el sistema pasa a la siguiente sin que el usuario lo note.
# Crea keys gratis en https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# (alternativa con una sola key, compatible con versiones anteriores)
# GROQ_API_KEY=gsk_...

# ─── Automatización ────────────────────────────────────────────────
# Resend (envío de emails). Sin esto el sistema usa el provider de consola en dev.
# Crea key en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Movil Guru <reparaciones@movilguru.com>"
RESEND_REPLY_TO=hola@movilguru.com

# Secreto compartido para los endpoints /api/cron/*. Vercel Cron lo envía
# automáticamente como Authorization: Bearer <CRON_SECRET>.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Nivel de log de la capa de automatización (debug | info | warn | error)
# AUTOMATION_LOG_LEVEL=info
