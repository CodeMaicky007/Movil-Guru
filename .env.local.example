# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI — pon varias keys separadas por coma para rotación automática.
# Cuando una se queda sin tokens, el sistema pasa a la siguiente sin que el usuario lo note.
# Puedes crear keys gratis en https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# (alternativa con una sola key, compatible con versiones anteriores)
# GROQ_API_KEY=gsk_...
